[Unit]
Description=ToDoMyrberg
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/todomyrberg/
ExecStartPre=/bin/sleep 60
ExecStart=/home/admin/todomyrberg/start.sh
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
